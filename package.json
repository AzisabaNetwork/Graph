{
  "name": "graph",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "generate:server": "rimraf server/generated && openapi-generator-cli generate -c server/generator-config.yaml",
    "generate:ts-sdk": "rimraf sdks/typescript/generated && openapi-generator-cli generate -c sdks/typescript/config.yaml",
    "generate:java-sdk": "rimraf sdks/java/generated && openapi-generator-cli generate -c sdks/java/config.yaml"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.39.1",
    "@redocly/cli": "^2.38.0",
    "rimraf": "^6.1.3"
  }
}
