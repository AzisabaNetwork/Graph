{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "types": [
      "node"
    ],
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "sdks/*/postprocess.ts"
  ]
}
